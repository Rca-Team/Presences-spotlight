# ─── Presences Spotlight AI Configuration (Appwrite Cloud Backend) ───────────

# 1. Appwrite Cloud Configuration (From Appwrite Project Settings & API Keys)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_DATABASE_ID=presences_db
APPWRITE_BUCKET_ID=face-images
APPWRITE_API_KEY=your-appwrite-server-api-key

# 2. Resend Email Parent Notifications
RESEND_API_KEY=re_your-resend-api-key

# 3. Google Gemini Vision AI (Optional for Security Audits)
GEMINI_API_KEY=your-gemini-api-key
ENABLE_GEMINI_AUDIT=false

# 4. Camera Video Stream
# Use "0" for USB / Laptop Webcam testing
# Use RTSP URL for PoE IP Bullet Camera (e.g. Hikvision / Dahua / Uniview)
RTSP_URL=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_FPS=30
FRAME_SCALE=0.5

# 5. Google Vision & Recognition Settings
VISION_PIPELINE=mediapipe
MATCH_THRESHOLD=0.42
AMBIGUITY_RATIO=0.82
CONSENSUS_FRAMES_REQUIRED=3
CONSENSUS_WINDOW_SECONDS=1.5
MIN_FACE_SIZE_PX=60
ENABLE_CANONICAL_ALIGNMENT=true
ENABLE_POSE_FILTER=true
MAX_POSE_YAW_DEG=38.0
MAX_POSE_PITCH_DEG=32.0
MIN_SHARPNESS_LAPLACIAN=35.0
ENABLE_LIVENESS_GUARD=true

# 6. Timing & Cutoffs
COOLDOWN_SECONDS=60
CUTOFF_HOUR=9
CUTOFF_MINUTE=0
STUDENT_SYNC_INTERVAL_SEC=300
GATE_NAME=Main Building Gate - Spotlight 1

# 7. Display & Audio Interface
SHOW_WINDOW=true
FULLSCREEN_KIOSK=false
ENABLE_AUDIO=true
SHOW_LANDMARK_MESH=false
