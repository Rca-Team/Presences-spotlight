# ==============================================================================
# Presences AI - Environment Variables Reference (.env.example)
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Appwrite Backend (Database, Storage, Auth, Realtime)
# ------------------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=presences_db
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (Jarvis AI Voice Assistant, Insights & AutoHeal)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 3. Email & Notification Services (Edge Functions / Server-Side)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
