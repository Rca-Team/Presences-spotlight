
# ==============================================================================
# Presences AI - Environment Variables Reference
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Supabase Configuration (Required for Main Application & Realtime)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ------------------------------------------------------------------------------
# 2. Jarvis AI & Autonomous Diagnostics Architecture
# ------------------------------------------------------------------------------
# Dedicated Jarvis Supabase instance for diagnostics, audit logs & telemetry
VITE_JARVIS_SUPABASE_URL=https://your-jarvis-ref.supabase.co
VITE_JARVIS_SUPABASE_ANON_KEY=your_jarvis_anon_key
JARVIS_SUPABASE_SERVICE_KEY=your_jarvis_service_role_key

# Google Gemini AI API Key (Used by Jarvis AI assistant, auto-healing & insights)
VITE_GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 3. Appwrite Backend / Secondary Adapter (Optional / Migration Support)
# ------------------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_server_api_key

# ------------------------------------------------------------------------------
# 4. Email & Notification Services (Edge Functions / Server-Side)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 5. Server-Side Supabase Service Role Key (Never expose to client bundles)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

