# ─── Presences Spotlight AI — Gate Terminal Configuration ─────────

# 1. Supabase Cloud Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# 2. Camera Input Source (0, 1 for USB Webcam, or rtsp:// stream URL for IP PoE camera)
RTSP_URL=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_FPS=30
FRAME_SCALE=0.5

# 3. Gate Terminal & Timetable Rules
GATE_NAME=Main School Gate — Spotlight 1
CUTOFF_HOUR=9
CUTOFF_MINUTE=0
MATCH_THRESHOLD=0.42
AMBIGUITY_RATIO=0.82
CONSENSUS_FRAMES_REQUIRED=3
CONSENSUS_WINDOW_SECONDS=1.5
COOLDOWN_SECONDS=60
STUDENT_SYNC_INTERVAL_SEC=300

# 4. Display & Audio Feedback
ENABLE_AUDIO=true
FULLSCREEN_KIOSK=false
SHOW_WINDOW=true
